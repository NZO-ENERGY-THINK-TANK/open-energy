# Optional server-side development proxy overrides. These are NOT VITE_* values.
# Default: the local FastAPI app. The value must be an origin without a path.
UPSTREAM_ORIGIN=http://127.0.0.1:8000

# Usually leave blank: Vite reads INTERNAL_API_KEY from ../backend/.env instead.
# Only use this override when developing against a separately configured backend.
OPEN_ENERGY_API_KEY=
